classDiagram
    %% PawPal+ class design (updated in Phase 2 with the logic layer)
    %% Owner has pets, each Pet has care tasks, and the Scheduler
    %% builds a daily plan from the owner's tasks and available time.

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str pet_name
        +str frequency
        +bool completed
        +priority_rank() int
        +mark_complete() None
        +describe() str
    }

    class Scheduler {
        +Owner owner
        +list~Task~ skipped_tasks
        +sort_by_priority(tasks: list~Task~) list~Task~
        +generate_plan() list~Task~
        +explain_plan(plan: list~Task~) str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Scheduler --> Owner : plans for
    Scheduler ..> Task : orders

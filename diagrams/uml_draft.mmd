classDiagram
    %% PawPal+ initial design draft (Step 3)
    %% Owner has pets, each Pet has care tasks, and the Scheduler
    %% builds a daily plan from the owner's tasks and available time.

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +priority_rank() int
    }

    class Scheduler {
        +Owner owner
        +generate_plan() list~Task~
        +explain_plan(plan: list~Task~) str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Scheduler --> Owner : plans for
    Scheduler ..> Task : orders
